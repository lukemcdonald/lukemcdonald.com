{
  "name": "lukemcdonald-astro",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "astro": "astro",
    "audit:code": "fallow audit && fallow health --score --hotspots --summary",
    "build": "astro build",
    "check": "astro check",
    "clean": "rm -rf .astro dist node_modules",
    "deploy:prod": "netlify deploy --build --prod",
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "format": "prettier .",
    "format:check": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write --ignore-unknown",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --fix --report-unused-disable-directives",
    "preinstall": "npx only-allow pnpm",
    "preview": "netlify deploy --build --message \"preview $(git rev-parse --short HEAD)\"",
    "reinstall": "pnpm run clean && pnpm install --frozen-lockfile",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "astro sync && tsc --noEmit",
    "validate": "pnpm run -s lint && pnpm run -s format:check && pnpm run -s check && pnpm run -s test"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@lucide/astro": "^1.38.0",
    "cuelume": "0.2.2",
    "date-fns": "4.4.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.10",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "fallow": "^3.21.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "pnpm@11.25.0"
}
