{
  "name": "lukemcdonald-astro",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "audit:code": "fallow audit && fallow health --score --hotspots --summary",
    "build": "astro build",
    "check": "astro check",
    "clean": "rm -rf .astro dist node_modules",
    "deploy:prod": "netlify deploy --build --prod",
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "fix": "pnpm run lint:fix && pnpm run format:fix",
    "format": "prettier .",
    "format:check": "prettier . --check --ignore-unknown",
    "format:fix": "prettier . --write --ignore-unknown",
    "lint": "eslint ./src --report-unused-disable-directives",
    "lint:fix": "eslint ./src --fix --report-unused-disable-directives",
    "preinstall": "npx only-allow pnpm",
    "preview": "netlify deploy --build --message \"preview $(git rev-parse --short HEAD)\"",
    "reinstall": "pnpm run clean && pnpm install --frozen-lockfile",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run -s lint && pnpm run -s format:check && pnpm run -s check"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@lucide/astro": "^0.577.0",
    "cuelume": "0.1.0",
    "date-fns": "4.1.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/netlify": "^7.0.3",
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.7",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "fallow": "^3.21.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "packageManager": "pnpm@11.24.0"
}
