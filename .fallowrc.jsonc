{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["netlify/functions/daily-rebuild/index.ts", "scripts/preview-static.mjs"],
  "framework": [
    {
      "configPatterns": ["playwright.config.ts"],
      "enablers": ["@playwright/test"],
      "entryPointRole": "test",
      "entryPoints": ["e2e/**/*.spec.ts"],
      "name": "playwright-e2e",
      "toolingDependencies": ["@axe-core/playwright", "@playwright/test"],
    },
  ],
  "ignoreDependencies": [
    // Resolved by Tailwind's CSS/config pipeline rather than JS imports.
    "@tailwindcss/typography",
    "tailwindcss",
  ],
  "ignoreExports": [
    {
      "exports": ["Props"],
      "file": "**/*.astro",
    },
  ],
}
