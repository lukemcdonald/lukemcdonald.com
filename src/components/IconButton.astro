---
import type { HTMLAttributes } from 'astro/types'

import { PRESS_CUE_PROPS } from '@/components/Sound'

const sizes = {
  lg: 'size-11',
  md: 'size-8',
  sm: 'size-6',
}

const variants = {
  ghost:
    'rounded-md bg-black/0 transition-colors hover:bg-black/5 motion-reduce:transition-none dark:hover:bg-white/10',
  solid:
    'rounded-md bg-primary-700 px-3 py-2 font-medium text-primary-50 shadow-sm transition-colors hover:bg-primary-700/80 motion-reduce:transition-none',
}

interface Props extends HTMLAttributes<'button'> {
  cue?: Record<string, boolean | string>
  label: string
  size?: keyof typeof sizes
  variant?: keyof typeof variants
}

const {
  class: className,
  cue = PRESS_CUE_PROPS,
  label,
  size = 'md',
  type = 'button',
  variant = 'ghost',
  ...delegated
} = Astro.props satisfies Props
---

<button
  aria-label={label}
  class:list={[
    'inline-flex shrink-0 items-center justify-center focus-ring',
    variant === 'ghost' && sizes[size],
    variants[variant],
    className,
  ]}
  type={type}
  {...cue}
  {...delegated}
>
  <slot />
</button>
