---
import type { CommandPaletteNavItem } from './types'

import SearchIcon from '@lucide/astro/icons/search'

import { getEasterEggs } from '@/components/EasterEggs/easter-eggs'
import GlassPicker from '@/components/Glass/Glass.astro'
import { HOVER_NAV_CUE_PROPS, TOGGLE_CUE_PROPS } from '@/components/Sound'
import SoundToggle from '@/components/Sound/Sound.astro'
import ThemeColorPicker from '@/components/ThemeColor/ThemeColor.astro'
import ThemeModePicker from '@/components/ThemeMode/ThemeMode.astro'

import { PALETTE_CHROME } from './chrome'
import { SECRETS_SHORTCUT_LABEL } from './utils'

interface Props {
  navigationItems?: CommandPaletteNavItem[]
}

const { navigationItems = [] } = Astro.props
const eggs = getEasterEggs()
const itemClass = `-mx-2 block rounded-lg px-2 py-1.5 text-base transition-colors ${PALETTE_CHROME.ink} ${PALETTE_CHROME.hoverFill}`
---

<div
  data-command-palette
  transition:name="command-palette"
  transition:persist
>
  <button
    aria-controls="command-palette-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="Open command palette"
    class="hidden rounded-md bg-black/0 px-2.5 py-2 text-base font-semibold tracking-wide text-primary-900 uppercase focus-ring hover:bg-black/5 sm:px-3 [@media(hover:hover)_and_(pointer:fine)]:inline-flex"
    data-command-palette-trigger
    data-testid="command-palette-trigger"
    type="button"
    {...HOVER_NAV_CUE_PROPS}
  >
    ⌘K
  </button>

  <dialog
    aria-label="Site navigation and preferences"
    class="fixed inset-0 z-50 m-0 h-dvh max-h-dvh w-full max-w-none border-0 bg-transparent p-4 backdrop:bg-transparent open:block focus:outline-hidden sm:p-6"
    data-command-palette-dialog
    id="command-palette-dialog"
  >
    <div class="flex min-h-full items-center justify-center">
      <div
        class="glass relative w-full max-w-2xl overflow-hidden rounded-xl glass-dialog"
        data-testid="command-palette"
      >
        <div class={`flex items-center border-b px-4 ${PALETTE_CHROME.border}`}>
          <SearchIcon
            aria-hidden="true"
            class={`h-5 w-5 ${PALETTE_CHROME.muted}`}
          />
          <input
            aria-label="Search"
            autocomplete="off"
            class={`w-full border-0 bg-transparent px-4 py-3 outline-none focus:ring-0 ${PALETTE_CHROME.ink} ${PALETTE_CHROME.placeholder}`}
            data-command-palette-input
            data-testid="command-palette-input"
            placeholder="Search..."
            type="text"
          />
          <kbd class={`${PALETTE_CHROME.kbd} ${PALETTE_CHROME.border} ${PALETTE_CHROME.muted}`}>
            ESC
          </kbd>
        </div>

        <div
          class={PALETTE_CHROME.list}
          data-palette-main
        >
          <div data-palette-nav-list>
            <h2 class={`mb-2 text-xs font-medium tracking-wider uppercase ${PALETTE_CHROME.muted}`}>
              Navigation
            </h2>
            {
              navigationItems.map((item) => (
                <a
                  class={itemClass}
                  data-name={item.name.toLowerCase()}
                  data-palette-nav
                  href={item.href}
                  {...HOVER_NAV_CUE_PROPS}
                >
                  {item.name}
                </a>
              ))
            }
          </div>
          <p
            class={`hidden py-6 text-center text-sm ${PALETTE_CHROME.muted}`}
            data-palette-empty
            role="status"
          >
            No matching pages
          </p>
        </div>

        <div
          class={`${PALETTE_CHROME.list} hidden`}
          data-palette-secrets
          data-testid="command-palette-secrets"
        >
          <h2
            class={`mb-2 text-xs font-medium tracking-wider uppercase ${PALETTE_CHROME.muted}`}
            data-palette-secrets-title
          >
            Secrets
          </h2>
          {
            eggs.map((egg) => (
              <button
                aria-pressed="false"
                class={`${itemClass} hidden w-full text-left`}
                data-name={egg.name.toLowerCase()}
                data-palette-egg={egg.id}
                type="button"
                {...TOGGLE_CUE_PROPS}
              >
                {egg.name}
              </button>
            ))
          }
        </div>

        <div class={`flex items-center gap-2 border-t px-3 py-2 ${PALETTE_CHROME.border}`}>
          <ThemeColorPicker />
          <div class="flex shrink-0 items-center gap-1">
            <span
              aria-hidden="true"
              class={`mr-1 h-5 border-l ${PALETTE_CHROME.border}`}
            ></span>
            <GlassPicker />
            <ThemeModePicker />
            <span
              aria-hidden="true"
              class={`h-5 border-l ${PALETTE_CHROME.border}`}
            ></span>
            <SoundToggle />
          </div>
        </div>

        <div
          class={`border-t px-4 py-3 ${PALETTE_CHROME.border}`}
          data-palette-secrets-footer
        >
          <button
            class={`-mx-1 flex items-center gap-2 rounded-lg px-1 py-0.5 text-xs transition-colors ${PALETTE_CHROME.focusRing} ${PALETTE_CHROME.hoverFill} ${PALETTE_CHROME.muted}`}
            data-palette-secrets-open
            data-testid="command-palette-secrets-footer"
            type="button"
          >
            <span data-palette-secrets-footer-label>Secrets 0/{eggs.length}</span>
            <kbd class={`${PALETTE_CHROME.kbd} ${PALETTE_CHROME.border} ${PALETTE_CHROME.muted}`}>
              {SECRETS_SHORTCUT_LABEL}
            </kbd>
          </button>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  import './command-palette'
</script>
