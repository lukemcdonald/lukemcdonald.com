---
import type { CommandPaletteNavGroup } from './types'

import CheckIcon from '@lucide/astro/icons/check'
import SearchIcon from '@lucide/astro/icons/search'

import { getEasterEggs } from '@/components/EasterEggs/easter-eggs'
import Settings from '@/components/Settings/Settings.astro'
import { HOVER_NAV_CUE_PROPS, TOGGLE_CUE_PROPS } from '@/components/Sound'
import {
  HEADER_TRIGGER_CLASS,
  toHrefTestId,
  toPaletteNavGroupId,
  toTestIdSlug,
} from '@/features/navigation/navigation.utils'

import { PALETTE_CHROME } from './chrome'
import { SECRETS_SHORTCUT_LABEL } from './utils'

interface Props {
  navigationGroups?: CommandPaletteNavGroup[]
}

const { navigationGroups = [] } = Astro.props
const eggs = getEasterEggs()
const itemClass = `-mx-2 block rounded-lg px-2 py-1.5 text-base transition-colors ${PALETTE_CHROME.ink} ${PALETTE_CHROME.hoverFill}`

function pageOptionId(href: string) {
  return `command-palette-page${href.replaceAll('/', '-')}`
}
---

<div
  data-command-palette
  transition:name="command-palette"
  transition:persist
>
  <button
    aria-controls="command-palette-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="⌘K Open command palette"
    class:list={[
      'hidden [@media(hover:hover)_and_(pointer:fine)]:inline-flex',
      HEADER_TRIGGER_CLASS,
    ]}
    data-command-palette-trigger
    data-testid="command-palette-trigger"
    type="button"
    {...HOVER_NAV_CUE_PROPS}
  >
    ⌘K
  </button>

  <dialog
    aria-label="Site navigation and preferences"
    class={PALETTE_CHROME.dialog}
    closedby="any"
    data-command-palette-dialog
    data-testid="command-palette-dialog"
    id="command-palette-dialog"
  >
    <div
      class={PALETTE_CHROME.panel}
      data-testid="command-palette"
    >
      <div class={`${PALETTE_CHROME.header} ${PALETTE_CHROME.border}`}>
        <SearchIcon
          aria-hidden="true"
          class={`h-5 w-5 ${PALETTE_CHROME.muted}`}
        />
        <input
          aria-autocomplete="list"
          aria-controls="command-palette-results"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-label="Search"
          autocomplete="off"
          class={`w-full border-0 bg-transparent px-4 py-3 outline-none focus:ring-0 ${PALETTE_CHROME.ink} ${PALETTE_CHROME.placeholder}`}
          data-command-palette-input
          data-testid="command-palette-input"
          placeholder="Search..."
          role="combobox"
          type="text"
        />
        <kbd
          class={`${PALETTE_CHROME.kbd} ${PALETTE_CHROME.kbdDesktop} ${PALETTE_CHROME.border} ${PALETTE_CHROME.muted}`}
        >
          ESC
        </kbd>
      </div>

      <div
        class={PALETTE_CHROME.list}
        data-palette-list
        data-testid="command-palette-list"
        style="--palette-list-height: 0px"
      >
        <div
          class="p-4"
          data-palette-list-sizer
        >
          <div data-palette-main>
            <div data-palette-nav-list>
              <div
                aria-label="Pages"
                class="flex flex-col gap-4"
                data-palette-results
                id="command-palette-results"
                role="listbox"
              >
                {navigationGroups.map((group) => {
                  const headingId = `command-palette-nav-heading-${toTestIdSlug(group.name)}`

                  return (
                    <div
                      aria-labelledby={headingId}
                      data-palette-nav-group
                      data-testid={toPaletteNavGroupId(group.name)}
                      role="group"
                    >
                      <h2
                        class={`mb-2 text-xs font-medium tracking-wider uppercase ${PALETTE_CHROME.muted}`}
                        data-palette-nav-heading
                        id={headingId}
                      >
                        {group.name}
                      </h2>
                      {group.links.map((item) => (
                        <a
                          class={itemClass}
                          data-name={item.name.toLowerCase()}
                          data-palette-nav
                          data-testid={toHrefTestId('command-palette-page', item.href)}
                          href={item.href}
                          id={pageOptionId(item.href)}
                          role="option"
                          tabindex="-1"
                          {...HOVER_NAV_CUE_PROPS}
                        >
                          {item.name}
                        </a>
                      ))}
                    </div>
                  )
                })}
              </div>
            </div>
            <p
              class={`py-6 text-center text-sm ${PALETTE_CHROME.muted}`}
              data-palette-empty
              hidden
              role="status"
            >
              No matching pages
            </p>
          </div>

          <div
            data-palette-secrets
            data-testid="command-palette-secrets"
            hidden
          >
            <h2
              class={`mb-2 text-xs font-medium tracking-wider uppercase ${PALETTE_CHROME.muted}`}
              data-palette-secrets-title
            >
              Secrets
            </h2>
            <div
              aria-label="Secrets"
              data-palette-secrets-list
              id="command-palette-secrets-list"
              role="listbox"
            >
              {eggs.map((egg) => (
                <button
                  aria-checked="false"
                  class={`group -mx-2 flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-left text-base transition-colors ${PALETTE_CHROME.ink}`}
                  data-name={egg.name.toLowerCase()}
                  data-palette-egg={egg.id}
                  data-testid={`command-palette-egg-${egg.id}`}
                  hidden
                  id={`command-palette-egg-${egg.id}`}
                  role="option"
                  tabindex="-1"
                  type="button"
                  {...TOGGLE_CUE_PROPS}
                >
                  <span
                    aria-hidden="true"
                    class="inline-flex h-4 w-4 shrink-0 items-center justify-center"
                  >
                    <CheckIcon class="invisible h-4 w-4 group-aria-checked:visible" />
                  </span>
                  <span class="min-w-0 flex-1">{egg.name}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <Settings variant="palette" />

      <div
        class={`flex items-center gap-2 border-t px-4 py-3 text-xs ${PALETTE_CHROME.border} ${PALETTE_CHROME.muted}`}
        data-palette-secrets-footer
        data-testid="command-palette-secrets-footer"
      >
        <span data-palette-secrets-footer-label>Secrets 0/{eggs.length}</span>
        <kbd
          class={`${PALETTE_CHROME.kbd} ${PALETTE_CHROME.kbdDesktop} ${PALETTE_CHROME.border}`}
          data-palette-secrets-footer-kbd
        >
          {SECRETS_SHORTCUT_LABEL}
        </kbd>
      </div>
    </div>
  </dialog>
</div>

<style>
  [data-palette-list] {
    height: var(--palette-list-height, auto);
    max-height: min(24.5625rem, calc(100dvh - 13rem));
    transition: height 100ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-palette-list] {
      transition: none;
    }
  }
</style>

<script>
  import './command-palette'
</script>
