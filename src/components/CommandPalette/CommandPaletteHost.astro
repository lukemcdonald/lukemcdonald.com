---
import CommandPalette from '@/components/CommandPalette/CommandPalette.astro'
import { getNavigationGroups } from '@/features/navigation/navigation.server'

import { toCommandPaletteNavItems } from './nav-items'

const groups = await getNavigationGroups()
const navigationItems = toCommandPaletteNavItems(groups)
---

<CommandPalette navigationItems={navigationItems} />
