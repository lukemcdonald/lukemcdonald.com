---
import { CommandPalette } from '@/components/CommandPalette'
import { getNavigationGroups } from '@/features/navigation/navigation.server'

const groups = await getNavigationGroups()
const navigationItems = groups.flatMap((group) => group.links)
---

<CommandPalette
  client:media="(hover: hover) and (pointer: fine)"
  navigationItems={navigationItems}
/>
