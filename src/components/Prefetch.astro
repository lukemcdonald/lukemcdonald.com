---
import { getImage } from 'astro:assets'

import { getNavigationGroups } from '@/features/navigation/navigation.server'
import { getInternalPrefetchHrefs } from '@/features/navigation/navigation.utils'
import {
  ENTRY_IMAGE_FIT,
  ENTRY_IMAGE_QUALITY,
  ENTRY_IMAGE_SIZES,
  ENTRY_IMAGE_WIDTHS,
  toPageHref,
} from '@/features/pages/pages.images'
import { getPublishedPages } from '@/features/pages/pages.server'

const groups = await getNavigationGroups()
const pageHrefs = getInternalPrefetchHrefs(groups)
const pages = await getPublishedPages()
const currentPath = Astro.url.pathname

const imageLinks = (
  await Promise.all(
    pages.map(async (page) => {
      const image = page.data.image

      if (!image) {
        return
      }

      const optimized = await getImage({
        fit: ENTRY_IMAGE_FIT,
        quality: ENTRY_IMAGE_QUALITY,
        src: image,
        widths: ENTRY_IMAGE_WIDTHS,
      })
      const href = toPageHref(page.id)

      if (currentPath === href) {
        return
      }

      return {
        href: optimized.src,
        srcSet: optimized.srcSet.attribute,
      }
    }),
  )
).filter((link) => link !== undefined)
---

{
  pageHrefs.map((href) => (
    <link
      href={href}
      rel="prefetch"
    />
  ))
}

{
  imageLinks.map(({ href, srcSet }) => (
    <link
      as="image"
      href={href}
      imagesizes={ENTRY_IMAGE_SIZES}
      imagesrcset={srcSet}
      rel="prefetch"
    />
  ))
}
