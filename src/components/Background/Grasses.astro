---
import Grass from '@/components/Background/Grass.astro'
import { pickGrassId } from '@/components/Background/utils'

const leftGrassId = pickGrassId()
const rightGrassId = pickGrassId({ excludeId: leftGrassId })
---

<div
  class="contents"
  data-grass
>
  <Grass
    id={rightGrassId}
    position="right"
  />

  <Grass
    id={leftGrassId}
    position="left"
  />
</div>
