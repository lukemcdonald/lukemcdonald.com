---
import ChevronDownIcon from '@lucide/astro/icons/chevron-down'
import MenuIcon from '@lucide/astro/icons/menu'
import XIcon from '@lucide/astro/icons/x'

import { HOVER_NAV_CUE_PROPS, TOGGLE_CUE_PROPS } from '@/components/Sound'
import { THEME_COLORS, THEME_LABELS } from '@/components/ThemeColor/constants'
import { MODE_LABELS, THEME_MODES } from '@/components/ThemeMode/constants'

type DestinationLink = {
  href: string
  name: string
}

export interface Props {
  groups: {
    links: DestinationLink[]
    name: string
  }[]
}

const { groups } = Astro.props

const selectClass =
  'min-h-11 w-full appearance-none rounded-lg border border-white/15 bg-primary-900 py-2 pr-10 pl-3 text-base font-normal tracking-normal text-primary-50 normal-case'
---

<div
  class="ml-auto [@media(hover:hover)_and_(pointer:fine)]:hidden"
  data-mobile-menu
>
  <button
    aria-controls="mobile-menu-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="Open menu"
    class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md bg-black/0 text-primary-900 transition-transform hover:bg-black/5 focus:outline-hidden active:scale-[0.96]"
    data-mobile-menu-trigger
    type="button"
    {...TOGGLE_CUE_PROPS}
  >
    <MenuIcon
      aria-hidden="true"
      class="h-6 w-6"
    />
  </button>

  <dialog
    aria-labelledby="mobile-menu-title"
    class="inset-0 m-0 h-dvh max-h-dvh w-full max-w-none overflow-auto overscroll-contain rounded-none border-0 bg-primary-900 p-0 text-primary-50 backdrop:bg-black/40"
    data-mobile-menu-dialog
    id="mobile-menu-dialog"
  >
    <div class="relative flex min-h-full flex-col">
      <h2
        class="sr-only"
        id="mobile-menu-title"
      >
        Menu
      </h2>

      <button
        aria-label="Close menu"
        autofocus
        class="absolute top-[max(0.5rem,env(safe-area-inset-top))] right-3 z-10 inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-primary-50 transition-transform hover:bg-white/5 focus:outline-hidden active:scale-[0.96]"
        data-mobile-menu-close
        type="button"
        {...TOGGLE_CUE_PROPS}
      >
        <XIcon
          aria-hidden="true"
          class="h-6 w-6"
        />
      </button>

      <div class="flex flex-1 flex-col gap-8 px-5 pt-[calc(1.25rem+env(safe-area-inset-top,0px))] pb-[calc(2.5rem+env(safe-area-inset-bottom,0px))]">
        <nav
          aria-label="Destinations"
          class="flex flex-col gap-6"
        >
          {
            groups.map((group) => (
              <section class="flex flex-col gap-1">
                <h3 class="text-xs font-medium tracking-wider text-white/50 uppercase">
                  {group.name}
                </h3>

                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a
                        class="flex items-center py-1.5 text-base font-medium tracking-wide uppercase transition-colors hover:bg-white/10"
                        data-mobile-menu-link
                        href={link.href}
                        {...HOVER_NAV_CUE_PROPS}
                      >
                        {link.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </nav>

        <div class="flex flex-col gap-5 border-t border-white/15 pt-6">
          <label
            class="flex flex-col gap-1.5 text-xs font-medium tracking-wider text-white/50 uppercase"
          >
            Theme
            <span class="relative block">
              <select
                class={selectClass}
                data-mobile-menu-theme
                name="theme"
              >
                {THEME_COLORS.map((color) => <option value={color}>{THEME_LABELS[color]}</option>)}
              </select>
              <ChevronDownIcon
                aria-hidden="true"
                class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-primary-50"
              />
            </span>
          </label>

          <label
            class="flex flex-col gap-1.5 text-xs font-medium tracking-wider text-white/50 uppercase"
          >
            Appearance
            <span class="relative block">
              <select
                class={selectClass}
                data-mobile-menu-mode
                name="appearance"
              >
                {THEME_MODES.map((mode) => <option value={mode}>{MODE_LABELS[mode]}</option>)}
              </select>
              <ChevronDownIcon
                aria-hidden="true"
                class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-primary-50"
              />
            </span>
          </label>

          <label
            class="flex min-h-11 items-center gap-3 text-xs font-medium tracking-wider text-white/50 uppercase"
          >
            <input
              class="h-5 w-5 accent-primary-700"
              data-mobile-menu-sound
              name="sound"
              type="checkbox"
            />
            Sound
          </label>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  import './mobile-menu'
</script>
