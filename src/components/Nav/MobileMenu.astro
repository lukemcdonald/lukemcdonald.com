---
import ChevronDownIcon from '@lucide/astro/icons/chevron-down'
import MenuIcon from '@lucide/astro/icons/menu'
import XIcon from '@lucide/astro/icons/x'

import { HOVER_NAV_CUE_PROPS, TOGGLE_CUE_PROPS } from '@/components/Sound'
import { THEME_COLORS, THEME_LABELS } from '@/components/ThemeColor/constants'
import { MODE_LABELS, THEME_MODES } from '@/components/ThemeMode/constants'

type DestinationLink = {
  href: string
  name: string
}

export interface Props {
  groups: {
    links: DestinationLink[]
    name: string
  }[]
}

const { groups } = Astro.props

const labelClass =
  'text-xs font-medium tracking-wider text-primary-800 uppercase dark:text-white/50'
const selectClass =
  'min-h-11 w-full appearance-none rounded-lg border border-black/15 bg-black/[0.04] py-2 pr-10 pl-3 text-base font-normal tracking-normal text-primary-900 dark:border-white/15 dark:bg-white/10 dark:text-primary-50'
---

<div
  class="ml-auto [@media(hover:hover)_and_(pointer:fine)]:hidden"
  data-mobile-menu
>
  <button
    aria-controls="mobile-menu-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="Open menu"
    class="group relative z-20 inline-flex min-h-11 min-w-11 items-center justify-center rounded-md bg-black/0 text-primary-900 transition-transform hover:bg-black/5 focus:outline-hidden active:scale-[0.96]"
    data-mobile-menu-trigger
    type="button"
    {...TOGGLE_CUE_PROPS}
  >
    <span class="relative h-6 w-6">
      <MenuIcon
        aria-hidden="true"
        class="absolute inset-0 h-6 w-6 transition-opacity duration-150 group-aria-expanded:opacity-0"
      />
      <XIcon
        aria-hidden="true"
        class="absolute inset-0 h-6 w-6 opacity-0 transition-opacity duration-150 group-aria-expanded:opacity-100"
      />
    </span>
  </button>

  <!-- Sheet starts below the header logo: p-5 + h-16 + p-5 -->
  <dialog
    aria-labelledby="mobile-menu-title"
    class="inset-0 m-0 h-dvh max-h-dvh w-full max-w-none touch-none flex-col overflow-visible overscroll-none border-0 bg-transparent p-0 pt-26 text-primary-900 scheme-light backdrop:bg-transparent open:flex focus:outline-hidden dark:text-primary-50 dark:scheme-dark"
    data-mobile-menu-dialog
    id="mobile-menu-dialog"
    tabindex="-1"
  >
    <!-- Top-layer twin of the page sampler so Safari can re-tint while the sheet is open. -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1.5 bg-primary-500"
      data-safari-chrome
    >
    </div>
    <div
      class="relative flex min-h-0 flex-1 flex-col overflow-visible rounded-t-3xl bg-white shadow-[0_-8px_24px_rgb(0_0_0_/_0.1)] dark:bg-primary-900 dark:shadow-[0_-10px_28px_rgb(0_0_0_/_0.45)]"
      data-mobile-menu-sheet
    >
      <h2
        class="sr-only"
        id="mobile-menu-title"
      >
        Menu
      </h2>

      <div
        class="flex min-h-0 flex-1 touch-pan-y flex-col gap-8 overflow-auto overscroll-contain px-5 pt-5 pb-10"
      >
        <nav
          aria-label="Destinations"
          class="flex flex-col gap-6"
        >
          {
            groups.map((group) => (
              <section class="flex flex-col gap-1">
                <h3 class={labelClass}>{group.name}</h3>

                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a
                        class="flex items-center py-2 text-xl font-semibold tracking-tight transition-colors hover:bg-black/5 dark:hover:bg-white/10"
                        data-mobile-menu-link
                        href={link.href}
                        {...HOVER_NAV_CUE_PROPS}
                      >
                        {link.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </nav>

        <div class="grid grid-cols-2 gap-3 border-t border-black/10 pt-6 dark:border-white/15">
          <label class={`flex flex-col gap-1.5 ${labelClass}`}>
            Theme
            <span class="relative block">
              <select
                class={selectClass}
                data-mobile-menu-theme
                name="theme"
              >
                {THEME_COLORS.map((color) => <option value={color}>{THEME_LABELS[color]}</option>)}
              </select>
              <ChevronDownIcon
                aria-hidden="true"
                class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-primary-900 dark:text-primary-50"
              />
            </span>
          </label>

          <label class={`flex flex-col gap-1.5 ${labelClass}`}>
            Appearance
            <span class="relative block">
              <select
                class={selectClass}
                data-mobile-menu-mode
                name="appearance"
              >
                {THEME_MODES.map((mode) => <option value={mode}>{MODE_LABELS[mode]}</option>)}
              </select>
              <ChevronDownIcon
                aria-hidden="true"
                class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-primary-900 dark:text-primary-50"
              />
            </span>
          </label>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  import './mobile-menu'
</script>
