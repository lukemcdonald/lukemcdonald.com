---
import type { MenuLink } from '@/features/navigation/navigation.types'

import { getNavigationGroups } from '@/features/navigation/navigation.server'

import MobileMenu from './MobileMenu.astro'
import NavMenu from './NavMenu'

const groups = await getNavigationGroups()

const menuLinks: MenuLink[] = groups.map((group) => {
  return {
    href: '#',
    links: group.links,
    name: group.name,
  }
})

const overlayGroups = groups
---

<nav
  class="flex grow items-center duration-200 peer-hover:opacity-0 peer-hover:delay-0 peer-hover:duration-0"
>
  <div class="hidden [@media(hover:hover)_and_(pointer:fine)]:contents">
    {
      menuLinks.map((menuLink) => (
        <NavMenu
          client:media="(hover: hover) and (pointer: fine)"
          link={menuLink}
        />
      ))
    }
  </div>

  <MobileMenu groups={overlayGroups} />
</nav>
