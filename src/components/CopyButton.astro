---
import CheckIcon from '@lucide/astro/icons/check'
import CopyIcon from '@lucide/astro/icons/copy'

import IconButton from '@/components/IconButton.astro'

interface Props {
  class?: string
  label: string
  testId?: string
  value: string
}

const { class: className, label, testId, value } = Astro.props
const statusTestId = testId ? `${testId}-status` : undefined
---

<span class="inline-flex items-center gap-1">
  <IconButton
    class:list={['text-primary-700 dark:text-primary-200', className]}
    data-copy={value}
    data-testid={testId}
    label={label}
    size="sm"
  >
    <CopyIcon
      aria-hidden="true"
      class="size-3.5"
      data-copy-idle
    />
    <CheckIcon
      aria-hidden="true"
      class="hidden size-3.5"
      data-copy-done
    />
  </IconButton>
  <span
    aria-live="polite"
    class="hidden pr-1 font-sans text-xs font-medium"
    data-copy-status
    data-testid={statusTestId}
  ></span>
</span>

<script>
  let registered = false

  document.addEventListener('astro:page-load', () => {
    if (registered) {
      return
    }

    registered = true
    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) {
        return
      }

      const button = target.closest('button[data-copy]')
      if (!(button instanceof HTMLButtonElement) || !button.dataset.copy) {
        return
      }

      const done = button.querySelector('[data-copy-done]')
      const idle = button.querySelector('[data-copy-idle]')
      const status = button.parentElement?.querySelector('[data-copy-status]')

      void navigator.clipboard.writeText(button.dataset.copy).then(() => {
        done?.classList.remove('hidden')
        idle?.classList.add('hidden')
        if (status) {
          status.classList.remove('hidden')
          status.textContent = 'Copied'
        }

        window.setTimeout(() => {
          done?.classList.add('hidden')
          idle?.classList.remove('hidden')
          if (status) {
            status.classList.add('hidden')
            status.textContent = ''
          }
        }, 2000)
      })
    })
  })
</script>
