---
import type { ImageMetadata } from 'astro'

import ContactInfo from '@/components/ContactInfo.astro'

import EntryBody from './EntryBody.astro'
import EntryHeader from './EntryHeader.astro'

export interface Props {
  description?: string
  image?: ImageMetadata | string
  imageAlt?: string
  subtitle?: string
  title: string
}

const { description, image, imageAlt, subtitle, title } = Astro.props

const resolvedDescription =
  Astro.slots.has('description') ? await Astro.slots.render('description') : description
---

<article class="entry min-h-screen w-full bg-primary-800 lg:min-h-0">
  <div class="relative">
    <!-- iOS Safari samples this while the header is on screen, then falls back to html. -->
    <div
      aria-hidden="true"
      class="pointer-events-none sticky top-0 z-20 -mb-1.5 h-1.5 bg-primary-500 lg:hidden"
    >
    </div>
    <EntryHeader
      description={resolvedDescription}
      subtitle={subtitle}
      title={title}
    />
  </div>

  <ContactInfo />

  <EntryBody
    image={image}
    imageAlt={imageAlt}
  >
    <slot />
  </EntryBody>
</article>
