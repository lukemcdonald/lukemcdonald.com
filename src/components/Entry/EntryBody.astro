---
import type { ImageMetadata } from 'astro'

import { Image } from 'astro:assets'
import { fade } from 'astro:transitions'

import {
  ENTRY_IMAGE_FIT,
  ENTRY_IMAGE_QUALITY,
  ENTRY_IMAGE_SIZES,
  ENTRY_IMAGE_WIDTHS,
} from '@/features/pages/pages.images'
import { ENTRY_COPY_FADE_MS, ENTRY_MEDIA_FADE_MS } from '@/features/pages/pages.transitions'

export interface Props {
  image?: ImageMetadata
  imageAlt?: string
}

const { image, imageAlt } = Astro.props
---

<div class="entry__body bg-primary-900">
  {
    image && (
      <figure
        class="entry__media relative isolate overflow-hidden bg-primary-500"
        transition:animate={fade({ duration: ENTRY_MEDIA_FADE_MS })}
        transition:name="entry-media"
      >
        <Image
          alt={imageAlt || ''}
          class="block h-full w-full mix-blend-lighten grayscale xs:object-cover"
          decoding="async"
          fetchpriority="high"
          fit={ENTRY_IMAGE_FIT}
          loading="eager"
          quality={ENTRY_IMAGE_QUALITY}
          sizes={ENTRY_IMAGE_SIZES}
          src={image}
          widths={ENTRY_IMAGE_WIDTHS}
        />
      </figure>
    )
  }

  <div
    class="entry__content relative z-10 flex flex-col justify-center bg-primary-900 px-5 py-10 text-lg leading-normal text-pretty wrap-break-word text-white xs:px-10"
    transition:animate={fade({ duration: ENTRY_COPY_FADE_MS })}
    transition:name="entry-content"
  >
    <slot />
  </div>
</div>
