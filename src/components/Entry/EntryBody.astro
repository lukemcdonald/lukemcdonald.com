---
import type { ImageMetadata } from 'astro'

import { Image } from 'astro:assets'

import {
  ENTRY_IMAGE_FIT,
  ENTRY_IMAGE_QUALITY,
  ENTRY_IMAGE_SIZES,
  ENTRY_IMAGE_WIDTHS,
  getEntryImageTransitionName,
} from '@/features/pages/pages.images'

export interface Props {
  image?: ImageMetadata
  imageAlt?: string
}

const { image, imageAlt } = Astro.props
---

<div class="entry__body bg-primary-900">
  {
    image && (
      <figure
        class="entry__media relative isolate bg-primary-500 mix-blend-lighten"
        transition:animate="fade"
        transition:name={getEntryImageTransitionName(image)}
      >
        <Image
          alt={imageAlt || ''}
          class="block h-full w-full grayscale xs:object-cover"
          decoding="async"
          fetchpriority="high"
          fit={ENTRY_IMAGE_FIT}
          loading="eager"
          quality={ENTRY_IMAGE_QUALITY}
          sizes={ENTRY_IMAGE_SIZES}
          src={image}
          widths={ENTRY_IMAGE_WIDTHS}
        />
      </figure>
    )
  }

  <div
    class="entry__content relative z-10 flex flex-col justify-center bg-primary-900 px-5 py-10 text-lg leading-normal text-pretty wrap-break-word text-white xs:px-10"
  >
    <slot />
  </div>
</div>
