---
import ChevronDownIcon from '@lucide/astro/icons/chevron-down'

import { PALETTE_CHROME } from '@/components/CommandPalette/chrome'
import GlassPicker from '@/components/Glass/Glass.astro'
import SoundToggle from '@/components/Sound/Sound.astro'
import { THEME_COLORS, THEME_LABELS } from '@/components/ThemeColor/constants'
import ThemeColorPicker from '@/components/ThemeColor/ThemeColor.astro'
import { MODE_LABELS, THEME_MODES } from '@/components/ThemeMode/constants'
import ThemeModePicker from '@/components/ThemeMode/ThemeMode.astro'

interface Props {
  variant: 'menu' | 'palette'
}

const { variant } = Astro.props
const isMenu = variant === 'menu'
const labelClass =
  'text-xs font-medium tracking-wider text-primary-800 uppercase dark:text-white/50'
const selectClass =
  'min-h-11 w-full appearance-none rounded-lg border border-primary-950/15 bg-black/[0.04] py-2 pr-10 pl-3 text-base font-normal tracking-normal text-primary-900 focus-ring dark:border-white/15 dark:bg-white/10 dark:text-primary-50'
---

{
  isMenu ?
    <div
      class="grid grid-cols-2 gap-3 border-t border-black/10 pt-6 dark:border-white/15"
      data-settings
      data-settings-variant="menu"
    >
      <label class={`flex flex-col gap-1.5 ${labelClass}`}>
        Theme
        <span class="relative block">
          <select
            class:list={selectClass}
            data-mobile-menu-theme
            data-settings-select="color"
            name="theme"
          >
            {THEME_COLORS.map((color) => (
              <option value={color}>{THEME_LABELS[color]}</option>
            ))}
          </select>
          <ChevronDownIcon
            aria-hidden="true"
            class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-primary-900 dark:text-primary-50"
          />
        </span>
      </label>

      <label class={`flex flex-col gap-1.5 ${labelClass}`}>
        Appearance
        <span class="relative block">
          <select
            class:list={selectClass}
            data-mobile-menu-mode
            data-settings-select="mode"
            data-testid="mobile-appearance"
            name="appearance"
          >
            {THEME_MODES.map((mode) => (
              <option value={mode}>{MODE_LABELS[mode]}</option>
            ))}
          </select>
          <ChevronDownIcon
            aria-hidden="true"
            class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-primary-900 dark:text-primary-50"
          />
        </span>
      </label>
    </div>
  : <div
      class={`flex items-center gap-2 border-t px-3 py-2 ${PALETTE_CHROME.border}`}
      data-settings
      data-settings-variant="palette"
    >
      <ThemeColorPicker />
      <div class="flex shrink-0 items-center gap-1">
        <span
          aria-hidden="true"
          class={`mr-1 h-5 border-l ${PALETTE_CHROME.border}`}
        />
        <GlassPicker />
        <ThemeModePicker />
        <span
          aria-hidden="true"
          class={`h-5 border-l ${PALETTE_CHROME.border}`}
        />
        <SoundToggle />
      </div>
    </div>
}
