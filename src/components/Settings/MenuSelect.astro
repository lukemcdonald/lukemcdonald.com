---
import ChevronDownIcon from '@lucide/astro/icons/chevron-down'

interface Props {
  kind: 'color' | 'font' | 'mode'
  label: string
  name: string
  testId?: string
}

const { kind, label, name, testId } = Astro.props
const labelClass =
  'text-xs font-medium tracking-wider text-primary-800 uppercase dark:text-white/50'
const selectClass =
  'min-h-11 w-full appearance-none rounded-lg border border-primary-950/15 bg-black/[0.04] py-2 pr-10 pl-3 text-base font-normal tracking-normal text-primary-900 focus-ring dark:border-white/15 dark:bg-white/10 dark:text-primary-50'
---

<label class={`flex flex-col gap-1.5 ${labelClass}`}>
  <span class="font-heading font-bold">{label}</span>
  <span class="relative block">
    <select
      class:list={selectClass}
      data-mobile-menu-mode={kind === 'mode' || undefined}
      data-mobile-menu-theme={kind === 'color' || undefined}
      data-settings-select={kind}
      data-testid={testId}
      name={name}
    >
      <slot />
    </select>
    <ChevronDownIcon
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-primary-900 dark:text-primary-50"
    />
  </span>
</label>
