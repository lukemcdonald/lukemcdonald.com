---
import { PALETTE_CHROME } from '@/components/CommandPalette/chrome'
import { LOADING_VERSE_LABEL } from '@/features/verse/verse.constants'

const AURORA_FIREFLY_COUNT = 10
const AURORA_FIREFLY_PATHS = ['a', 'b', 'c'] as const
const AURORA_FIREFLIES = Array.from({ length: AURORA_FIREFLY_COUNT }, (_, index) => {
  return AURORA_FIREFLY_PATHS[index % AURORA_FIREFLY_PATHS.length]
})
---

<template data-lamp-template>
  <div data-lamp>
    <div data-lamp-veil></div>
    <div data-lamp-glow></div>
    <div
      aria-hidden="true"
      data-lamp-fireflies
    >
      {AURORA_FIREFLIES.map((path) => {
        return <span data-aurora-firefly={path}></span>
      })}
    </div>
    <div
      aria-busy="true"
      data-lamp-verse
    >
      <p>
        <span class="sr-only">{LOADING_VERSE_LABEL}</span>
        <span
          aria-hidden="true"
          data-lamp-skeleton
        >
          <span data-lamp-skeleton-line></span>
          <span data-lamp-skeleton-line></span>
        </span>
      </p>
      <cite>
        <span
          aria-hidden="true"
          data-lamp-skeleton
        >
          <span data-lamp-skeleton-line></span>
        </span>
      </cite>
    </div>
    <div
      aria-hidden="true"
      data-lamp-cursor
    >
      <svg
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 2.5c1 1.3 1.4 2.4 1.4 3.4a1.4 1.4 0 1 1-2.8 0c0-1 .4-2.1 1.4-3.4"></path>
        <path d="M12 7.5v2"></path>
        <path d="M8 10.5h8"></path>
        <path d="M7.5 10.5c-2 1.3-3.2 3.2-3.2 5.2 0 3 3.4 5.3 7.7 5.3s7.7-2.3 7.7-5.3c0-2-1.2-3.9-3.2-5.2"></path>
        <path d="M4.5 14.8c-2.2.2-3.7 1.5-3.7 3.1 0 1.6 1.6 2.6 3.4 2.2"></path>
        <path d="M19.2 12.6c1.3-.6 2.8-1 3.8-.6"></path>
      </svg>
    </div>
  </div>
</template>

<dialog
  aria-labelledby="fca-egg-caption"
  class={PALETTE_CHROME.dialog}
  closedby="any"
  data-fca-dialog
  data-testid="fca-egg-dialog"
  tabindex="-1"
>
  <div class={PALETTE_CHROME.panel}>
    <div
      class="relative aspect-video bg-primary-950"
      data-fca-embed
    ></div>
    <div
      class={`${PALETTE_CHROME.footer} text-sm ${PALETTE_CHROME.border} ${PALETTE_CHROME.muted}`}
    >
      <p
        class="min-w-0 flex-1 text-pretty"
        id="fca-egg-caption"
      >
        Everyone has a place on God's team.
      </p>
      <form method="dialog">
        <button
          aria-label="Close"
          class={`${PALETTE_CHROME.kbd} ${PALETTE_CHROME.border} bg-transparent`}
          data-testid="fca-egg-close"
          type="submit"
        >
          ESC
        </button>
      </form>
    </div>
  </div>
</dialog>

<script>
  import { initializeEasterEggs } from './easter-eggs'

  initializeEasterEggs()
</script>
