---
import { getTodayVerse } from '@/features/verse/verse.server'

const verse = await getTodayVerse()
---

<template data-lamp-template>
  <div data-lamp>
    <div data-lamp-veil></div>
    <div data-lamp-glow></div>
    <div data-lamp-verse>
      <p>{verse.text}</p>
      <cite>{verse.reference}</cite>
    </div>
  </div>
</template>

<script>
  import { initializeEasterEggs } from './easter-eggs'

  initializeEasterEggs()
</script>
