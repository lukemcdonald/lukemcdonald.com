---
import XIcon from '@lucide/astro/icons/x'

import IconButton from '@/components/IconButton.astro'
import { LOADING_VERSE_LABEL } from '@/features/verse/verse.constants'
---

<template data-lamp-template>
  <div data-lamp>
    <div data-lamp-veil></div>
    <div data-lamp-glow></div>
    <div
      aria-hidden="true"
      data-lamp-fireflies
    >
      <span data-aurora-firefly="a"></span>
      <span data-aurora-firefly="b"></span>
      <span data-aurora-firefly="c"></span>
      <span data-aurora-firefly="a"></span>
      <span data-aurora-firefly="b"></span>
      <span data-aurora-firefly="c"></span>
      <span data-aurora-firefly="a"></span>
      <span data-aurora-firefly="b"></span>
      <span data-aurora-firefly="c"></span>
      <span data-aurora-firefly="a"></span>
    </div>
    <div
      aria-busy="true"
      data-lamp-verse
    >
      <p>
        <span class="sr-only">{LOADING_VERSE_LABEL}</span>
        <span
          aria-hidden="true"
          data-lamp-skeleton
        >
          <span data-lamp-skeleton-line></span>
          <span data-lamp-skeleton-line></span>
        </span>
      </p>
      <cite>
        <span
          aria-hidden="true"
          data-lamp-skeleton
        >
          <span data-lamp-skeleton-line></span>
        </span>
      </cite>
    </div>
    <div
      aria-hidden="true"
      data-lamp-cursor
    >
      <svg
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 2.5c1 1.3 1.4 2.4 1.4 3.4a1.4 1.4 0 1 1-2.8 0c0-1 .4-2.1 1.4-3.4"></path>
        <path d="M12 7.5v2"></path>
        <path d="M8 10.5h8"></path>
        <path d="M7.5 10.5c-2 1.3-3.2 3.2-3.2 5.2 0 3 3.4 5.3 7.7 5.3s7.7-2.3 7.7-5.3c0-2-1.2-3.9-3.2-5.2"></path>
        <path d="M4.5 14.8c-2.2.2-3.7 1.5-3.7 3.1 0 1.6 1.6 2.6 3.4 2.2"></path>
        <path d="M19.2 12.6c1.3-.6 2.8-1 3.8-.6"></path>
      </svg>
    </div>
  </div>
</template>

<dialog
  aria-labelledby="team-egg-caption"
  class="fixed inset-0 z-50 m-0 h-dvh max-h-dvh w-full max-w-none items-center justify-center border-0 bg-transparent p-4 backdrop:bg-transparent open:flex focus:outline-hidden sm:p-6"
  closedby="any"
  data-team-dialog
  data-testid="team-egg-dialog"
>
  <div class="glass relative w-full max-w-lg overflow-hidden rounded-xl p-4 glass-dialog sm:p-5">
    <div class="mb-3 flex justify-end">
      <form method="dialog">
        <IconButton
          class="size-10 text-primary-700 dark:text-primary-200"
          label="Close video"
          type="submit"
        >
          <XIcon
            aria-hidden="true"
            class="size-4"
          />
        </IconButton>
      </form>
    </div>
    <div
      class="relative aspect-video overflow-hidden rounded-lg bg-primary-950"
      data-team-embed
    ></div>
    <p
      class="mt-3 text-center text-sm text-pretty text-primary-900 dark:text-white"
      id="team-egg-caption"
    >
      Everyone has a place on God's team.
    </p>
  </div>
</dialog>

<script>
  import { initializeEasterEggs } from './easter-eggs'

  initializeEasterEggs()
</script>
