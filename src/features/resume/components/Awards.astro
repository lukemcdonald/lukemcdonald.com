---
import type { AwardItem } from '@/features/resume/resume.types'

import AwardsIcon from '@lucide/astro/icons/medal'

import Section from '@/features/resume/components/ui/Section.astro'

export interface Props {
  awards: AwardItem[]
}

const { awards } = Astro.props
---

<Section
  title="Awards & Accomplishments"
  icon={AwardsIcon}
>
  <ul>
    {
      awards.map((item) => (
        <li>
          {item.title}
          {item.org && ` — ${item.org}`}
          {item.date && ` (${item.date})`}
        </li>
      ))
    }
  </ul>
</Section>
