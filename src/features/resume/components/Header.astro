---
import type { BasicsItem } from '@/features/resume/resume.types'

import GlobeIcon from '@lucide/astro/icons/globe'
import BriefcaseIcon from '@lucide/astro/icons/handshake'
import MailIcon from '@lucide/astro/icons/mail'

import GithubIcon from '@/components/Icons/Github.astro'

export interface Props {
  basics: BasicsItem
}

const icons = {
  email: MailIcon,
  github: GithubIcon,
  linkedin: BriefcaseIcon,
  website: GlobeIcon,
} as const

const { basics } = Astro.props

const { email, intro, label: subtitle, name: title, profiles, website } = basics || {}

const linkList = [
  {
    href: email ? `mailto:${email}` : undefined,
    icon: icons.email,
    label: 'Email',
  },
  {
    href: website,
    icon: icons.website,
    label: 'Website',
  },
  ...(profiles?.map((profile) => ({
    href: profile?.url,
    icon: icons[profile?.network?.toLowerCase() as keyof typeof icons],
    label: profile?.network,
  })) || []),
]

const introParagraphs = intro
  ?.split('\n\n')
  .map((paragraph) => paragraph.trim())
  .filter(Boolean)
---

<header>
  <div
    class="flex flex-col justify-between gap-4 sm:flex-row sm:items-baseline print:flex-col print:items-start"
  >
    <h1 class="mb-0 shrink-0">
      <a
        class="not-prose no-underline hover:underline"
        data-cuelume-hover="tick"
        href="/"
      >
        {title}
      </a>
    </h1>

    <dl class="not-prose flex flex-wrap gap-x-3 sm:gap-x-5 print:block">
      {
        linkList.map((link) => (
          <>
            <dt class="sr-only">{link.label}</dt>
            <dd class="flex items-center gap-2">
              <link.icon class="size-4" />
              <a
                class="print:hidden"
                data-cuelume-hover="tick"
                href={link.href}
              >
                {link.label}
              </a>
              <code class="hidden print:block print:text-xs">{link.href}</code>
            </dd>
          </>
        ))
      }
    </dl>
  </div>

  {
    subtitle && (
      <h2
        class="mt-12 mb-4 font-semibold print:mt-6"
        set:html={subtitle}
      />
    )
  }

  {introParagraphs?.map((paragraph) => <p>{paragraph}</p>)}
</header>
