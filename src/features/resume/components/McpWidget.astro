---
import ChevronDown from '@lucide/astro/icons/chevron-down'
import XIcon from '@lucide/astro/icons/x'

import CopyButton from '@/components/CopyButton.astro'
import { PRESS_CUE_PROPS, TOGGLE_CUE_PROPS } from '@/components/Sound'
import { MCP_URL } from '@/features/mcp/mcp.constants'
import { STORAGE_KEYS } from '@/utils/storage'

const storageKey = STORAGE_KEYS.resumeMcpWidget
---

<script define:vars={{ storageKey }} is:inline>
  try {
    if (localStorage.getItem(storageKey)) {
      document.documentElement.dataset.resumeMcpHidden = ''
    }
  } catch {}
</script>

<style is:global>
  html[data-resume-mcp-hidden] [data-resume-mcp-widget] {
    display: none;
  }
</style>

<aside
  aria-label="Ask your AI about me"
  class="group not-prose mb-6 border-b border-primary-900/10 pb-1 text-sm text-primary-800 max-md:mr-14 2xl:sticky 2xl:top-6 2xl:col-start-1 2xl:mr-0 2xl:mb-0 2xl:w-72 2xl:self-start 2xl:justify-self-end 2xl:rounded-lg 2xl:border 2xl:border-primary-900/10 2xl:bg-white/90 2xl:p-4 2xl:pb-4 2xl:shadow-sm dark:border-white/10 dark:text-primary-100 dark:2xl:bg-primary-900/90 print:hidden"
  data-resume-mcp-widget
  data-testid="resume-mcp-widget"
>
  <div class="flex items-center justify-between gap-2">
    <button
      aria-controls="resume-mcp-panel"
      aria-expanded="false"
      class="group inline-flex min-h-11 flex-1 items-center gap-1.5 py-0.5 text-left font-semibold text-pretty text-primary-950 focus-ring 2xl:hidden dark:text-primary-50"
      data-resume-mcp-toggle
      data-testid="resume-mcp-toggle"
      type="button"
      {...TOGGLE_CUE_PROPS}
    >
      Ask your AI about me
      <ChevronDown
        aria-hidden="true"
        class="size-3.5 shrink-0 transition-transform duration-150 group-aria-expanded:rotate-180 motion-reduce:transition-none"
      />
    </button>
    <p class="hidden font-semibold text-pretty text-primary-950 2xl:block dark:text-primary-50">
      Ask your AI about me
    </p>
    <button
      aria-label="Dismiss AI assistant widget"
      class="inline-flex size-11 shrink-0 items-center justify-center rounded-md text-primary-700 focus-ring hover:bg-primary-900/8 2xl:size-8 dark:text-primary-200 dark:hover:bg-white/10"
      data-resume-mcp-dismiss
      data-testid="resume-mcp-dismiss"
      type="button"
      {...PRESS_CUE_PROPS}
    >
      <XIcon
        aria-hidden="true"
        class="size-4"
      />
    </button>
  </div>

  <div
    class="hidden group-data-open:block 2xl:block"
    data-resume-mcp-panel
    id="resume-mcp-panel"
  >
    <p class="mt-2 mb-0 text-pretty text-primary-700 dark:text-primary-200">
      Connect your AI assistant to ask about my experience and work.
    </p>
    <div
      class="mt-3 inline-flex max-w-full items-center gap-1 rounded-sm bg-primary-900/8 py-0.5 pr-0.5 pl-1.5 font-mono text-xs text-primary-800 dark:bg-white/10 dark:text-primary-100"
    >
      <code
        class="bg-transparent p-0 text-inherit"
        data-testid="resume-mcp-url"
      >
        {MCP_URL}
      </code>
      <CopyButton
        label="Copy MCP URL"
        value={MCP_URL}
      />
    </div>
    <p class="mt-4 mb-1.5 text-xs font-medium text-primary-700 dark:text-primary-200">Try asking</p>
  </div>
</aside>

<script>
  import './mcp-widget'
</script>
