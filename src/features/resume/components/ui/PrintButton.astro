---
import PrinterIcon from '@lucide/astro/icons/printer'

import IconButton from '@/components/IconButton.astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<IconButton
  class:list={['print:hidden', className]}
  label="Print"
  onclick="window.print()"
  variant="solid"
>
  <PrinterIcon
    aria-hidden="true"
    class="size-5"
  />
</IconButton>
