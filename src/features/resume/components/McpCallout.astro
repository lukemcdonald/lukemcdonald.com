---
import SparklesIcon from '@lucide/astro/icons/sparkles'

import CopyButton from '@/components/CopyButton.astro'
import { MCP_URL } from '@/features/mcp/mcp.constants'
---

<aside
  class="not-prose my-5 flex gap-2.5 rounded-md border-l-2 border-primary-500 bg-primary-500/10 px-3 py-2.5 text-sm text-primary-800 dark:border-primary-400 dark:bg-primary-400/12 dark:text-primary-100 print:hidden"
  data-testid="resume-mcp-callout"
>
  <SparklesIcon
    aria-hidden="true"
    class="mt-0.5 size-4 shrink-0 text-primary-600 dark:text-primary-300"
  />
  <div class="min-w-0">
    <p class="mb-0 font-semibold text-primary-950 dark:text-primary-50">
      Connect your AI assistant
    </p>
    <div class="mt-1.5 inline-flex max-w-full items-center gap-1 rounded-sm bg-primary-900/8 py-0.5 pr-0.5 pl-1.5 font-mono text-xs text-primary-800 dark:bg-white/10 dark:text-primary-100">
      <code
        class="bg-transparent p-0 text-inherit"
        data-testid="resume-mcp-url"
      >
        {MCP_URL}
      </code>
      <CopyButton
        label="Copy MCP URL"
        value={MCP_URL}
      />
    </div>
  </div>
</aside>
