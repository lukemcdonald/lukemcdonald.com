---
import CheckIcon from '@lucide/astro/icons/check'
import CopyIcon from '@lucide/astro/icons/copy'
import SparklesIcon from '@lucide/astro/icons/sparkles'

import { PRESS_CUE_PROPS } from '@/components/Sound'
import { MCP_URL } from '@/features/mcp/mcp.constants'

import { COPY_BUTTON_LABEL } from './mcp-callout'
---

<aside
  class="not-prose my-5 flex gap-2.5 rounded-md border-l-2 border-primary-500 bg-primary-500/10 px-3 py-2.5 text-sm text-primary-800 dark:border-primary-400 dark:bg-primary-400/12 dark:text-primary-100 print:hidden"
  data-mcp-callout
  data-testid="resume-mcp-callout"
>
  <SparklesIcon
    aria-hidden="true"
    class="mt-0.5 size-4 shrink-0 text-primary-600 dark:text-primary-300"
  />
  <div class="min-w-0">
    <p class="mb-0 font-semibold text-primary-950 dark:text-primary-50">
      Ask an AI about this resume
    </p>
    <div
      class="mt-1.5 inline-flex max-w-full items-center gap-1 rounded-sm bg-primary-900/8 py-0.5 pr-0.5 pl-1.5 font-mono text-xs text-primary-800 dark:bg-white/10 dark:text-primary-100"
    >
      <code
        class="bg-transparent p-0 text-inherit"
        data-testid="resume-mcp-url"
      >
        {MCP_URL}
      </code>
      <button
        aria-label={COPY_BUTTON_LABEL}
        class="inline-flex size-6 shrink-0 items-center justify-center rounded-sm text-primary-700 focus-ring transition-colors hover:bg-primary-900/8 motion-reduce:transition-none dark:text-primary-200 dark:hover:bg-white/10"
        data-mcp-copy={MCP_URL}
        data-testid="resume-mcp-copy"
        type="button"
        {...PRESS_CUE_PROPS}
      >
        <CopyIcon
          aria-hidden="true"
          class="size-3.5"
          data-mcp-copy-icon="idle"
        />
        <CheckIcon
          aria-hidden="true"
          class="hidden size-3.5"
          data-mcp-copy-icon="done"
        />
      </button>
      <span
        aria-live="polite"
        class="hidden pr-1 font-sans text-xs font-medium"
        data-mcp-copy-status
        data-testid="resume-mcp-copy-status"
      ></span>
    </div>
  </div>
</aside>

<script>
  import { bindMcpCallouts } from './mcp-callout'

  document.addEventListener('astro:page-load', () => {
    bindMcpCallouts()
  })
</script>
