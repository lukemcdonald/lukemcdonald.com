---
import type { EducationItem } from '@/features/resume/resume.types'

import EducationIcon from '@lucide/astro/icons/brain'

import Section from '@/features/resume/components/ui/Section.astro'

export interface Props {
  education: EducationItem[]
}

const { education } = Astro.props
---

<Section
  title="Education"
  icon={EducationIcon}
>
  <ul class="list-none px-0">
    {education.map((item) => (
      <li class="p-0 first:mt-0 last:mb-0">
        <strong>{item.studyType} {item.area}</strong>
        {' '}— {item.institution}
      </li>
    ))}
  </ul>
</Section>
