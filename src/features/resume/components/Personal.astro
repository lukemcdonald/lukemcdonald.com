---
import PersonalIcon from '@lucide/astro/icons/signature'

import Section from '@/features/resume/components/ui/Section.astro'

export interface Props {
  personal: string[]
}

const { personal } = Astro.props
---

<Section
  title="Personal"
  icon={PersonalIcon}
>
  <ul class="list-none px-0">
    {personal.map((item) => <li class="p-0 first:mt-0 last:mb-0">{item}</li>)}
  </ul>
</Section>
