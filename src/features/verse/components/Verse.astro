---
import Link from '@/components/Link.astro'

import { loadTodayVerse } from '../verse.server'
import { buildVerseCacheHeaders, formatVerseLead } from '../verse.utils'

const verse = await loadTodayVerse()

for (const [name, value] of Object.entries(buildVerseCacheHeaders())) {
  Astro.response.headers.set(name, value)
}
---

{formatVerseLead(verse.source)}
<blockquote class="mt-8 font-sans text-lg leading-normal">
  <p>{verse.text}</p>
</blockquote>
<p class="mt-3 font-sans text-sm text-white/50">
  <Link
    href={verse.url}
    target="_blank"
    underline="hover"
  >
    — {verse.reference}
  </Link>
</p>
