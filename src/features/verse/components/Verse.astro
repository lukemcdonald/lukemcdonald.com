---
import type { Verse } from '../verse.types'

import Link from '@/components/Link.astro'

import { getTodayVerse } from '../verse.server'
import { verseCacheHeaders } from '../verse.utils'

interface Props {
  verse?: Verse
}

const { verse: providedVerse } = Astro.props
const verse = providedVerse ?? (await getTodayVerse())

if (!providedVerse) {
  for (const [name, value] of Object.entries(verseCacheHeaders())) {
    Astro.response.headers.set(name, value)
  }
}

const errorMessage =
  verse.source === 'api' ?
    "Page not found. Here's today's verse."
  : "Page not found. Here's a verse."
---

<pre
  class="text-base leading-7 whitespace-normal">
  <span class="rounded-xs bg-primary-500 px-1 py-px font-sans text-sm font-medium text-primary-900 uppercase">
    Error
  </span>
  <span class="mt-2 block">{errorMessage}</span>
</pre>
<blockquote class="mt-8">
  <p>{verse.text}</p>
</blockquote>
<p class="mt-3 text-sm text-white/50">
  <Link
    href={verse.url}
    target="_blank"
    underline="hover"
  >
    — {verse.reference}
  </Link>
</p>
