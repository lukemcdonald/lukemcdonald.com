---
import MenuIcon from '@lucide/astro/icons/menu'
import XIcon from '@lucide/astro/icons/x'

import IconButton from '@/components/IconButton.astro'
import Settings from '@/components/Settings/Settings.astro'
import { HOVER_NAV_CUE_PROPS, TOGGLE_CUE_PROPS } from '@/components/Sound'
import { toHrefTestId } from '@/features/navigation/navigation.utils'

type DestinationLink = {
  href: string
  name: string
}

export interface Props {
  groups: {
    links: DestinationLink[]
    name: string
  }[]
}

const { groups } = Astro.props

const labelClass =
  'text-xs font-medium tracking-wider text-primary-800 uppercase dark:text-white/50'
---

<div
  class="ml-auto [@media(hover:hover)_and_(pointer:fine)]:hidden"
  data-mobile-menu
  data-testid="mobile-menu"
>
  <IconButton
    aria-controls="mobile-menu-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
    class="group relative z-20 text-primary-900 transition-transform active:scale-[0.96]"
    cue={TOGGLE_CUE_PROPS}
    data-mobile-menu-trigger
    data-testid="mobile-menu-trigger"
    label="Open menu"
    size="lg"
  >
    <span class="relative h-6 w-6">
      <MenuIcon
        aria-hidden="true"
        class="absolute inset-0 h-6 w-6 transition-opacity duration-150 group-aria-expanded:opacity-0"
      />
      <XIcon
        aria-hidden="true"
        class="absolute inset-0 h-6 w-6 opacity-0 transition-opacity duration-150 group-aria-expanded:opacity-100"
      />
    </span>
  </IconButton>

  <!-- Sheet starts below the header logo: p-5 + h-16 + p-5 -->
  <dialog
    aria-labelledby="mobile-menu-title"
    class="inset-0 m-0 h-dvh max-h-dvh w-full max-w-none touch-none flex-col overflow-visible overscroll-none border-0 bg-transparent p-0 pt-26 text-primary-900 scheme-light backdrop:bg-transparent open:flex focus:outline-hidden dark:text-primary-50 dark:scheme-dark"
    data-mobile-menu-dialog
    id="mobile-menu-dialog"
    tabindex="-1"
  >
    <div
      class="relative flex min-h-0 flex-1 flex-col overflow-visible rounded-t-3xl bg-white shadow-[0_-8px_24px_rgb(0_0_0_/_0.1)] dark:bg-primary-900 dark:shadow-[0_-10px_28px_rgb(0_0_0_/_0.45)]"
      data-mobile-menu-sheet
    >
      <h2
        class="sr-only"
        id="mobile-menu-title"
      >
        Menu
      </h2>

      <div class="flex min-h-0 flex-1 touch-pan-y flex-col gap-8 overflow-auto overscroll-contain px-5 pt-5 pb-10">
        <nav
          aria-label="Destinations"
          class="flex flex-col gap-6"
        >
          {groups.map((group) => (
            <section class="flex flex-col gap-1">
              <h3 class={labelClass}>{group.name}</h3>

              <ul>
                {group.links.map((link) => (
                  <li>
                    <a
                      class="inline-flex w-fit items-center py-2 text-xl font-semibold tracking-tight focus-ring transition-colors hover:bg-black/5 dark:hover:bg-white/10"
                      data-mobile-menu-link
                      data-testid={toHrefTestId('nav-link', link.href)}
                      href={link.href}
                      {...HOVER_NAV_CUE_PROPS}
                    >
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>

        <Settings variant="menu" />
      </div>
    </div>
  </dialog>
</div>

<script>
  import './mobile-menu'
</script>
