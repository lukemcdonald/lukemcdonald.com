---
import Entry from '@/components/Entry/Entry.astro'
import Verse from '@/features/verse/components/Verse.astro'
import { FALLBACK_VERSE } from '@/features/verse/verse.utils'
import Layout from '@/layouts/Layout.astro'
import Main from '@/layouts/Main.astro'
import { createErrorData } from '@/utils/error'

const { image, imageAlt, subtitle, title } = createErrorData(404)
---

<Layout title={subtitle ?? title}>
  <Main>
    <Entry
      image={image}
      imageAlt={imageAlt}
      subtitle={subtitle}
      title={title}
    >
      <pre
        class="text-base leading-7 whitespace-normal">
        <span class="rounded-xs bg-primary-500 px-1 py-px font-sans text-sm font-medium text-primary-900 uppercase">
          Error
        </span>
        <span class="mt-2 block">
          Page not found. <Verse server:defer>
            <Verse slot="fallback" verse={FALLBACK_VERSE} />
          </Verse>
        </span>
      </pre>
    </Entry>
  </Main>
</Layout>
