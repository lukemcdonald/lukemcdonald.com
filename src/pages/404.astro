---
import Entry from '@/components/Entry/Entry.astro'
import Link from '@/components/Link.astro'
import { getTodayVerse } from '@/features/verse/verse.server'
import Layout from '@/layouts/Layout.astro'
import Main from '@/layouts/Main.astro'
import { createErrorData } from '@/utils/error'

const verse = await getTodayVerse()
const errorMessage =
  verse.source === 'api' ?
    "The page you're looking for doesn't exist, but here's today's verse."
  : "The page you're looking for doesn't exist, but here's a verse."
const errorData = createErrorData(404, errorMessage)
const { html, image, imageAlt, subtitle, title } = errorData
---

<Layout title={subtitle ?? title}>
  <Main>
    <Entry
      image={image}
      imageAlt={imageAlt}
      subtitle={subtitle}
      title={title}
    >
      <Fragment set:html={html} />
      <blockquote class="mt-8">
        <p>{verse.text}</p>
      </blockquote>
      <p class="mt-3 text-sm text-white/50">
        <Link
          href={verse.url}
          target="_blank"
          underline="hover"
        >
          — {verse.reference}
        </Link>
      </p>
    </Entry>
  </Main>
</Layout>
