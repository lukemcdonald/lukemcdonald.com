---
import Badge from '@/components/Badge.astro'
import Entry from '@/components/Entry/Entry.astro'
import Link from '@/components/Link.astro'
import { getTodayVerse } from '@/features/verse/verse.server'
import Layout from '@/layouts/Layout.astro'
import Main from '@/layouts/Main.astro'
import { createErrorData } from '@/utils/error'

const errorData = createErrorData(404, 'The page you are looking for does not exist.')
const verse = await getTodayVerse()
const { html, image, imageAlt, subtitle, title } = errorData
---

<Layout title={subtitle ?? title}>
  <Main>
    <Entry
      image={image}
      imageAlt={imageAlt}
      subtitle={subtitle}
      title={title}
    >
      <Fragment set:html={html} />
      {
        verse.source === 'api' && (
          <p>
            <Badge>Verse of the day</Badge>
          </p>
        )
      }
      <blockquote>
        <p>{verse.text}</p>
        <p>
          <Link
            href={verse.url}
            target="_blank"
          >
            {verse.reference}
          </Link>
        </p>
      </blockquote>
    </Entry>
  </Main>
</Layout>
