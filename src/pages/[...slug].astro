---
import { render } from 'astro:content'

import Entry from '@/components/Entry/Entry.astro'
import { loadPublishedPages } from '@/features/pages/pages.server'
import { omitIndexPage, toPageSeo } from '@/features/pages/pages.utils'
import Layout from '@/layouts/Layout.astro'
import Main from '@/layouts/Main.astro'

export async function getStaticPaths() {
  const pages = await loadPublishedPages()

  return omitIndexPage(pages).map((page) => ({
    params: { slug: page.id },
    props: { page },
  }))
}

const { page } = Astro.props

if (!page) {
  return new Response(null, { status: 404 })
}

const { description, image, imageAlt, modDate, pubDate, subtitle, title } = page.data
const { Content } = await render(page)
const { description: seoDescription, ogImage, title: seoTitle } = toPageSeo(page)
---

<Layout
  contentType="page"
  description={seoDescription}
  modDate={modDate}
  ogImage={ogImage}
  photo={image}
  pubDate={pubDate}
  title={seoTitle}
>
  <Main>
    <Entry
      description={description}
      image={image}
      imageAlt={imageAlt}
      subtitle={subtitle}
      title={title}
    >
      <Content />
    </Entry>
  </Main>
</Layout>
