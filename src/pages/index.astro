---
import { getEntry, render } from 'astro:content'

import Entry from '@/components/Entry/Entry.astro'
import GreetingLinks from '@/components/GreetingLinks.astro'
import { resolvePageSeo } from '@/features/pages/pages.utils'
import Layout from '@/layouts/Layout.astro'
import Main from '@/layouts/Main.astro'

const page = await getEntry('pages', 'index')

if (!page) {
  return new Response(null, { status: 404 })
}

const { image, imageAlt, modDate, pubDate, subtitle, title } = page.data
const { description: seoDescription, ogImage, title: seoTitle } = resolvePageSeo(page)

const { Content } = await render(page)
---

<Layout
  description={seoDescription}
  modDate={modDate}
  ogImage={ogImage}
  pubDate={pubDate}
  title={seoTitle}
>
  <Main>
    <Entry
      image={image}
      imageAlt={imageAlt}
      subtitle={subtitle}
      title={title}
    >
      <GreetingLinks slot="description" />
      <Content />
    </Entry>
  </Main>
</Layout>
