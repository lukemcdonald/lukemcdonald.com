---
import type { SeoMeta } from '@/utils/seo'

import OgMeta from 'astro-og-kit/OgMeta.astro'
import { getEntry } from 'astro:content'
import { CLOUDFLARE_ANALYTICS_TOKEN, GOOGLE_SITE_VERIFICATION } from 'astro:env/client'
import { CONTEXT } from 'astro:env/server'
import { ClientRouter } from 'astro:transitions'
import { componentDataByCssVariable } from 'virtual:astro:assets/fonts/internal'

import {
  FONT_PAIRING_CSS_SCRIPT_ID,
  FONT_PAIRINGS,
  fontPairingCss,
  fontPairingFacesCss,
} from '@/components/Settings/Font/pairings'
import { DEFAULT_GLASS_LEVEL, GLASS_LEVELS } from '@/components/Settings/Glass/constants'
import { DEFAULT_THEME_COLOR, THEME_COLORS } from '@/components/Settings/ThemeColor/constants'
import { DEFAULT_THEME_MODE } from '@/components/Settings/ThemeMode/constants'
import { CLOUDFLARE_WEB_ANALYTICS, createCloudflareBeaconConfig } from '@/configs/analytics'
import { GLOBAL_CONFIG } from '@/configs/global'
import { toPageSeo } from '@/features/pages/pages.utils'
import { loadResumeData } from '@/features/resume/resume.server'
import { buildGraphJsonLd } from '@/utils/seo'
import { STORAGE_KEYS } from '@/utils/storage'
import { stripHtmlAndTruncate } from '@/utils/text'

export interface Props {
  generator?: string
  meta: SeoMeta
}

const { generator, meta } = Astro.props
const {
  author,
  canonicalUrl,
  contentType,
  description: inDescription,
  heading,
  modDate,
  ogImage,
  photo,
  pubDate,
  robots: inRobots,
  title: inTitle,
} = meta
const googlebot = inRobots ?? 'index, follow'
const robots = inRobots ?? 'index, follow, max-image-preview:large'
const ogType = contentType === 'article' || contentType === 'blog' ? 'article' : 'website'

const siteNameLower = GLOBAL_CONFIG.name.trim().toLowerCase()
const baseTitle = (inTitle ?? GLOBAL_CONFIG.name).trim()
const hasSiteName = baseTitle.toLowerCase().includes(siteNameLower)
const title = hasSiteName ? baseTitle : `${baseTitle} - ${GLOBAL_CONFIG.name}`

const description = stripHtmlAndTruncate(inDescription, 160, '...')

const defaultGlassLevel = DEFAULT_GLASS_LEVEL
const defaultThemeColor = DEFAULT_THEME_COLOR
const defaultThemeMode = DEFAULT_THEME_MODE
const fontPairingCssScriptId = FONT_PAIRING_CSS_SCRIPT_ID
const fontPairings = FONT_PAIRINGS
const glassLevels = GLASS_LEVELS
const metaForSeo: SeoMeta = { ...meta, description }
const pairingCss = fontPairingCss()
const pairingFontCss = fontPairingFacesCss((cssVariable) => {
  return componentDataByCssVariable.get(cssVariable)?.css ?? ''
})
const home = await getEntry('pages', 'index')
const homeImageSrc = home?.data.image?.src
const resume = await loadResumeData()
const structuredData = buildGraphJsonLd(metaForSeo, {
  description: (home ? toPageSeo(home).description : undefined) || resume.basics.intro,
  image: homeImageSrc ? new URL(homeImageSrc, GLOBAL_CONFIG.site.origin).href : undefined,
  jobTitle: resume.basics.label,
})
const themeColors = THEME_COLORS
---

<head>
  <script
    id={fontPairingCssScriptId}
    is:inline
    set:html={JSON.stringify(pairingFontCss)}
    type="application/json"
  />
  <!-- Apply stored theme and easter egg before CSS to prevent flash. -->
  <script
    define:vars={{
      defaultGlassLevel,
      defaultThemeColor,
      defaultThemeMode,
      fontPairingCssScriptId,
      fontPairings,
      glassLevels,
      STORAGE_KEYS,
      themeColors,
    }}
    is:inline
  >
    ;(function () {
      try {
        const getSystemPreference = () => {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark'
          }

          return 'light'
        }

        const storedColorRaw = localStorage.getItem(STORAGE_KEYS.themeColor)
        const storedColor =
          themeColors.includes(storedColorRaw) ? storedColorRaw : defaultThemeColor
        const storedMode = localStorage.getItem(STORAGE_KEYS.themeMode) || defaultThemeMode
        const effectiveMode = storedMode === 'system' ? getSystemPreference() : storedMode

        const html = document.documentElement
        const storedGlass = localStorage.getItem(STORAGE_KEYS.glass)
        html.dataset.glass = glassLevels.includes(storedGlass) ? storedGlass : defaultGlassLevel

        const storedFont = localStorage.getItem(STORAGE_KEYS.font)
        if (fontPairings.includes(storedFont)) {
          html.dataset.font = storedFont
          try {
            const cssNode = document.getElementById(fontPairingCssScriptId)
            const pairingFontCss = JSON.parse((cssNode && cssNode.textContent) || '{}')
            const css = pairingFontCss[storedFont]
            const styleId = 'font-pairing-' + storedFont
            if (css && !document.getElementById(styleId)) {
              const style = document.createElement('style')
              style.id = styleId
              style.textContent = css
              document.head.append(style)
            }
          } catch {}
        } else {
          delete html.dataset.font
        }

        if (storedColor !== 'default') {
          html.setAttribute('data-theme', storedColor)
        } else {
          html.removeAttribute('data-theme')
        }

        if (effectiveMode === 'dark') {
          html.classList.add('dark')
        } else {
          html.classList.remove('dark')
        }
      } catch (e) {
        // eslint-disable-next-line no-console
        console.error('Failed to initialize theme:', e)
      }
    })()
  </script>
  <script
    define:vars={{ STORAGE_KEYS }}
    is:inline
  >
    ;(function () {
      try {
        const html = document.documentElement
        const on = 'on'

        for (let index = 0; index < localStorage.length; index += 1) {
          const key = localStorage.key(index)

          if (!key || key.indexOf(STORAGE_KEYS.easterEggPrefix) !== 0) {
            continue
          }

          if (localStorage.getItem(key) !== on) {
            continue
          }

          html.setAttribute('data-easter-egg', key.slice(STORAGE_KEYS.easterEggPrefix.length))
          break
        }
      } catch {}
    })()
  </script>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />

  <style
    is:inline
    set:html={pairingCss}
  ></style>
  <meta
    name="googlebot"
    content={googlebot}
  />
  <meta
    name="robots"
    content={robots}
  />

  {GOOGLE_SITE_VERIFICATION && (
    <meta
      name="google-site-verification"
      content={GOOGLE_SITE_VERIFICATION}
    />
  )}

  <link
    href="/favicon.ico"
    rel="icon"
    sizes="48x48"
  />
  <link
    href="/favicon.svg"
    rel="icon"
    type="image/svg+xml"
  />
  <link
    href="/apple-touch-icon.png"
    rel="apple-touch-icon"
  />
  <link
    href="/site.webmanifest"
    rel="manifest"
  />

  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />

  <title>{title}</title>
  <link
    rel="canonical"
    href={canonicalUrl}
  />
  {description && (
    <meta
      name="description"
      content={description}
    />
  )}
  {author?.name && (
    <meta
      name="author"
      content={author.name}
    />
  )}
  {generator && (
    <meta
      name="generator"
      content={generator}
    />
  )}

  {pubDate && (
    <meta
      property="article:published_time"
      content={pubDate.toISOString()}
    />
  )}
  {modDate && (
    <meta
      property="article:modified_time"
      content={modDate.toISOString()}
    />
  )}

  <OgMeta
    description={description}
    heading={heading}
    image={ogImage}
    photo={photo}
    siteName={GLOBAL_CONFIG.name}
    title={inTitle}
    type={ogType}
    url={canonicalUrl}
  />

  <script
    data-testid="json-ld"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <meta
    name="theme-color"
    content={GLOBAL_CONFIG.themeColor}
  />

  {CONTEXT === 'production' && CLOUDFLARE_ANALYTICS_TOKEN && (
    <script
      data-cf-beacon={JSON.stringify(createCloudflareBeaconConfig(CLOUDFLARE_ANALYTICS_TOKEN))}
      defer
      is:inline
      src={CLOUDFLARE_WEB_ANALYTICS.scriptPath}
    />
  )}

  <ClientRouter />
</head>
