---
import type { SeoMeta } from '@/utils/seo'

import { Font } from 'astro:assets'
import { CLOUDFLARE_ANALYTICS_TOKEN, GOOGLE_SITE_VERIFICATION } from 'astro:env/client'
import { CONTEXT } from 'astro:env/server'
import { ClientRouter } from 'astro:transitions'

import {
  FONT_PAIRINGS,
  FONT_SOURCE_FAMILIES,
  fontPairingCss,
} from '@/components/Settings/Font/pairings'
import { DEFAULT_GLASS_LEVEL, GLASS_LEVELS } from '@/components/Settings/Glass/constants'
import { DEFAULT_THEME_COLOR, THEME_COLORS } from '@/components/Settings/ThemeColor/constants'
import { DEFAULT_THEME_MODE } from '@/components/Settings/ThemeMode/constants'
import { CLOUDFLARE_WEB_ANALYTICS, getCloudflareBeaconConfig } from '@/configs/analytics'
import { GLOBAL_CONFIG } from '@/configs/global'
import { buildGraphJsonLd, buildSocialMetaTags } from '@/utils/seo'
import { STORAGE_KEYS } from '@/utils/storage'
import { stripHtmlAndTruncate } from '@/utils/text'

export interface Props {
  generator?: string
  meta: SeoMeta
}

const { generator, meta } = Astro.props
const { author, canonicalUrl, description: inDescription, modDate, pubDate, title: inTitle } = meta

const siteNameLower = GLOBAL_CONFIG.name.trim().toLowerCase()
const baseTitle = (inTitle ?? GLOBAL_CONFIG.name).trim()
const hasSiteName = baseTitle.toLowerCase().includes(siteNameLower)
const title = hasSiteName ? baseTitle : `${baseTitle} - ${GLOBAL_CONFIG.name}`

// Clean and optimize the description for meta tags
const description = stripHtmlAndTruncate(inDescription, 160, '...')

// Create JSON-LD graph ([WebSite, Page]) and social meta tags
const defaultGlassLevel = DEFAULT_GLASS_LEVEL
const defaultThemeColor = DEFAULT_THEME_COLOR
const defaultThemeMode = DEFAULT_THEME_MODE
const easterEggPrefix = STORAGE_KEYS.easterEggPrefix
const fontPairings = FONT_PAIRINGS
const glassLevels = GLASS_LEVELS
const metaForSeo: SeoMeta = { ...meta, description }
const pairingCss = fontPairingCss()
const socialMetaTags = buildSocialMetaTags(metaForSeo, Astro.site ?? GLOBAL_CONFIG.site.origin)
const storageKeys = STORAGE_KEYS
const structuredData = buildGraphJsonLd(metaForSeo)
const themeColors = THEME_COLORS
---

<head>
  <!-- Theme and easter-egg initialization (prevents flash) - must run before any CSS -->
  <script
    define:vars={{
      defaultGlassLevel,
      defaultThemeColor,
      defaultThemeMode,
      fontPairings,
      glassLevels,
      storageKeys,
      themeColors,
    }}
    is:inline
  >
    ;(function () {
      try {
        const getSystemPreference = () => {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark'
          }

          return 'light'
        }

        const storedColorRaw = localStorage.getItem(storageKeys.themeColor)
        const storedColor =
          themeColors.includes(storedColorRaw) ? storedColorRaw : defaultThemeColor
        const storedMode = localStorage.getItem(storageKeys.themeMode) || defaultThemeMode
        const effectiveMode = storedMode === 'system' ? getSystemPreference() : storedMode

        const html = document.documentElement
        const storedGlass = localStorage.getItem(storageKeys.glass)
        html.dataset.glass = glassLevels.includes(storedGlass) ? storedGlass : defaultGlassLevel

        const storedFont = localStorage.getItem(storageKeys.font)
        if (fontPairings.includes(storedFont)) {
          html.dataset.font = storedFont
        } else {
          delete html.dataset.font
        }

        if (storedColor !== 'default') {
          html.setAttribute('data-theme', storedColor)
        } else {
          html.removeAttribute('data-theme')
        }

        if (effectiveMode === 'dark') {
          html.classList.add('dark')
        } else {
          html.classList.remove('dark')
        }
      } catch (e) {
        // eslint-disable-next-line no-console
        console.error('Failed to initialize theme:', e)
      }
    })()
  </script>
  <script define:vars={{ easterEggPrefix }} is:inline>
    ;(function () {
      try {
        const html = document.documentElement
        const on = 'on'

        for (let index = 0; index < localStorage.length; index += 1) {
          const key = localStorage.key(index)

          if (!key || key.indexOf(easterEggPrefix) !== 0) {
            continue
          }

          if (localStorage.getItem(key) !== on) {
            continue
          }

          html.setAttribute('data-easter-egg', key.slice(easterEggPrefix.length))
          break
        }
      } catch {}
    })()
  </script>

  <!-- Basic HTML Head Elements -->
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />

  {FONT_SOURCE_FAMILIES.map((family) => <Font cssVariable={family.cssVariable} />)}
  <style is:inline set:html={pairingCss}></style>
  <meta
    name="googlebot"
    content="index, follow"
  />
  <meta
    name="robots"
    content="index, follow, max-image-preview:large"
  />

  {
    GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={GOOGLE_SITE_VERIFICATION}
      />
    )
  }

  <!-- Favicon -->
  <link
    href="/favicon.svg"
    rel="icon"
    type="image/svg+xml"
  />
  <link
    href="/apple-touch-icon.png"
    rel="apple-touch-icon"
  />

  <!-- Sitemap -->
  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />

  <!-- General Meta Tags -->
  <title>{title}</title>
  <link
    rel="canonical"
    href={canonicalUrl}
  />
  {
    description && (
      <meta
        name="description"
        content={description}
      />
    )
  }
  {
    author?.name && (
      <meta
        name="author"
        content={author.name}
      />
    )
  }
  {
    generator && (
      <meta
        name="generator"
        content={generator}
      />
    )
  }

  <!-- Article Published/Modified time -->
  {
    pubDate && (
      <meta
        property="article:published_time"
        content={pubDate.toISOString()}
      />
    )
  }
  {
    modDate && (
      <meta
        property="article:modified_time"
        content={modDate.toISOString()}
      />
    )
  }

  <!-- Open Graph / Facebook -->
  <meta
    property="og:title"
    content={socialMetaTags['og:title']}
  />
  <meta
    property="og:url"
    content={socialMetaTags['og:url']}
  />
  <meta
    property="og:image"
    content={socialMetaTags['og:image']}
  />
  <meta
    property="og:image:width"
    content={socialMetaTags['og:image:width']}
  />
  <meta
    property="og:image:height"
    content={socialMetaTags['og:image:height']}
  />
  <meta
    property="og:site_name"
    content={socialMetaTags['og:site_name']}
  />
  <meta
    property="og:type"
    content={socialMetaTags['og:type']}
  />
  {
    socialMetaTags['og:description'] && (
      <meta
        property="og:description"
        content={socialMetaTags['og:description']}
      />
    )
  }

  <!-- Twitter -->
  <meta
    name="twitter:card"
    content={socialMetaTags['twitter:card']}
  />
  <meta
    name="twitter:url"
    content={socialMetaTags['twitter:url']}
  />
  <meta
    name="twitter:title"
    content={socialMetaTags['twitter:title']}
  />
  <meta
    name="twitter:image"
    content={socialMetaTags['twitter:image']}
  />
  {
    socialMetaTags['twitter:description'] && (
      <meta
        name="twitter:description"
        content={socialMetaTags['twitter:description']}
      />
    )
  }

  <!-- Google JSON-LD Structured data (@graph) -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <!-- Theme color -->
  <meta
    name="theme-color"
    content={GLOBAL_CONFIG.themeColor}
  />

  {
    CONTEXT === 'production' && CLOUDFLARE_ANALYTICS_TOKEN && (
      <script
        data-cf-beacon={JSON.stringify(getCloudflareBeaconConfig(CLOUDFLARE_ANALYTICS_TOKEN))}
        defer
        is:inline
        src={CLOUDFLARE_WEB_ANALYTICS.scriptPath}
      />
    )
  }

  <!-- View Transitions API -->
  <ClientRouter />
</head>
