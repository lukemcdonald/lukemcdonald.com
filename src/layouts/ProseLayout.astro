---
import Prose from '@/components/Prose.astro'

import Layout from './Layout.astro'

const { description, proseClass, robots, title } = Astro.props
---

<Layout
  bodyClass="bg-white text-primary-900 dark:bg-primary-900 dark:text-primary-50"
  description={description}
  robots={robots}
  title={title}
>
  <main
    class="px-4 py-6"
    data-testid="main"
    id="main"
    tabindex="-1"
  >
    <slot name="before-prose" />
    <Prose
      as="article"
      class:list={['mx-auto', proseClass]}
    >
      <slot />
    </Prose>
    <slot name="after-prose" />
  </main>
</Layout>
