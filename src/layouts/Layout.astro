---
import type { SeoMeta } from '@/utils/seo'

import '@/assets/styles/global.css'

import EasterEggs from '@/components/EasterEggs/EasterEggs.astro'
import { GLOBAL_CONFIG } from '@/configs/global'
import Head from '@/layouts/Head.astro'

export interface Props extends SeoMeta {
  bodyClass?: string
}

const { generator, props, site, url } = Astro

const canonicalUrl = new URL(url.pathname, site ?? url).href

const {
  author = GLOBAL_CONFIG.author,
  bodyClass,
  dir = GLOBAL_CONFIG.dir,
  lang = GLOBAL_CONFIG.lang ?? 'en',
  title = GLOBAL_CONFIG.name,
  ...siteMeta
} = props

const meta: SeoMeta = {
  author,
  canonicalUrl,
  dir,
  lang,
  title,
  ...siteMeta,
}
---

<!doctype html>
<html
  class="bg-primary-50 dark:bg-primary-900"
  dir={dir}
  lang={lang}
>
  <Head
    generator={generator}
    meta={meta}
  />

  <body class:list={{ [bodyClass!]: Boolean(bodyClass) }}>
    <a
      class="sr-only no-underline focus-ring transition-none focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-md focus:bg-primary-900 focus:px-4 focus:py-2 focus:font-semibold focus:text-primary-50 dark:focus:bg-primary-50 dark:focus:text-primary-900"
      data-testid="skip-link"
      href="#main"
    >
      Skip to content
    </a>

    <EasterEggs />

    <!-- Safari samples a fixed top bar (>=3px, not display:none) for chrome tint. Hidden from lg+; html already matches the shell. -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1.5 bg-primary-500 lg:hidden"
    ></div>

    <svg
      aria-hidden="true"
      class="pointer-events-none absolute h-0 w-0"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <filter
          height="100%"
          id="glass-lens"
          width="100%"
          x="0%"
          y="0%"
        >
          <feGaussianBlur
            in="SourceAlpha"
            result="blur"
            stdDeviation="50"
          ></feGaussianBlur>
          <feDisplacementMap
            in="SourceGraphic"
            in2="blur"
            scale="50"
            xChannelSelector="A"
            yChannelSelector="A"
          ></feDisplacementMap>
        </filter>
      </defs>
    </svg>

    <slot />

    <script>
      import { applyFontPairing, getFontPairing } from '@/components/Settings/Font/font'
      import { applyGlassLevel, getGlassLevel } from '@/components/Settings/Glass/utils'
      import { initializeSound, playPageArrival } from '@/components/Settings/Sound/utils'
      import { getThemeColor } from '@/components/Settings/ThemeColor/utils'
      import {
        getEffectiveThemeMode,
        watchSystemPreference,
      } from '@/components/Settings/ThemeMode/utils'
      import { applyThemeColor, applyThemeMode } from '@/utils/theme'

      let cleanupWatcher: (() => void) | null = null
      let isFirstAstroPageLoad = true

      function setupTheme() {
        applyFontPairing(getFontPairing())
        applyGlassLevel(getGlassLevel())
        applyThemeColor(getThemeColor())
        applyThemeMode(getEffectiveThemeMode())

        if (cleanupWatcher) {
          cleanupWatcher()
        }

        cleanupWatcher = watchSystemPreference()
      }

      function setup() {
        setupTheme()
        initializeSound()
      }

      function onAstroPageLoad() {
        setup()

        if (isFirstAstroPageLoad) {
          isFirstAstroPageLoad = false
          return
        }

        playPageArrival()
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setup)
      } else {
        setup()
      }

      document.addEventListener('astro:before-preparation', () => {
        if (cleanupWatcher) {
          cleanupWatcher()
          cleanupWatcher = null
        }
      })

      // Theme on swap (FOUC); sound on page-load only, once per navigation.
      document.addEventListener('astro:after-swap', setupTheme)
      document.addEventListener('astro:page-load', onAstroPageLoad)
    </script>
  </body>
</html>
