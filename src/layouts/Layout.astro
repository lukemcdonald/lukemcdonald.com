---
import type { SeoMeta } from '@/utils/seo'

import '@/assets/styles/global.css'

import { GLOBAL_CONFIG } from '@/configs/global'
import Head from '@/layouts/Head.astro'

type Theme = 'default' | 'blue' | 'purple' | 'yellow' | 'green' | 'orange' | 'neon'

export interface Props extends SeoMeta {
  bodyClass?: string
  theme?: Theme
}

const { generator, props, site, url } = Astro

const canonicalUrl = new URL(url.pathname, site ?? url).href

const {
  author = GLOBAL_CONFIG.author,
  bodyClass,
  dir = GLOBAL_CONFIG.dir,
  lang = GLOBAL_CONFIG.lang ?? 'en',
  title = GLOBAL_CONFIG.name,
  ...siteMeta
} = props

const meta: SeoMeta = {
  author,
  canonicalUrl,
  dir,
  lang,
  title,
  ...siteMeta,
}
---

<!doctype html>
<html
  dir={dir}
  lang={lang}
>
  <Head
    generator={generator}
    meta={meta}
  />

  <body class:list={{ [bodyClass!]: Boolean(bodyClass) }}>
    <slot />

    <!-- Theme initialization and system preference watcher -->
    <script>
      import { watchSystemPreference } from '@/components/ThemeMode'
      import { initializeTheme } from '@/utils/theme'

      let cleanupWatcher: (() => void) | null = null

      function setupTheme() {
        // Initialize theme first to set the correct mode from localStorage
        initializeTheme()

        // Clean up previous watcher if it exists
        if (cleanupWatcher) {
          cleanupWatcher()
        }

        // Watch for system preference changes after initialization
        cleanupWatcher = watchSystemPreference()
      }

      // Initialize theme on page load (backup for inline script)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupTheme)
      } else {
        setupTheme()
      }

      // Cleanup on page unload (for view transitions)
      document.addEventListener('astro:before-preparation', () => {
        if (cleanupWatcher) {
          cleanupWatcher()
          cleanupWatcher = null
        }
      })

      // Re-initialize theme on view transitions (client-side navigation)
      document.addEventListener('astro:after-swap', setupTheme)
      document.addEventListener('astro:page-load', setupTheme)
    </script>
  </body>
</html>
